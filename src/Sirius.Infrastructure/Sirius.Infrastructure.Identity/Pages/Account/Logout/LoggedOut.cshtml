@page
@namespace Sirius.Infrastructure.Identity.Pages.Account.Logout
@using Sirius.Infrastructure.Identity.Pages.Account.Logout
@model Sirius.Infrastructure.Identity.Pages.Account.Logout.LoggedOut

<div class="identity-page identity-page-result logged-out-page">
    <section class="identity-card identity-card-narrow identity-result-card">
        <h1 class="identity-title">Signed out</h1>
        <p class="identity-support-text">You are now logged out.</p>

        @if (Model.View.PostLogoutRedirectUri is not null)
        {
            <p class="identity-support-text identity-support-text-sm">
                Click <a class="PostLogoutRedirectUri" href="@Model.View.PostLogoutRedirectUri">here</a> to return to the
                <span>@Model.View.ClientName</span> application.
            </p>
        }

        @if (Model.View.SignOutIframeUrl is not null)
        {
            <iframe width="0" height="0" class="signout" src="@Model.View.SignOutIframeUrl"></iframe>
        }
    </section>
</div>

@section scripts
{
    @if (Model.View.AutomaticRedirectAfterSignOut)
    {
        <script src="~/js/signout-redirect.js"></script>
    }
}