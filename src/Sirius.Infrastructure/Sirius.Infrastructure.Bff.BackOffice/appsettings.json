{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "accounts": {
        "ClusterId": "accounts",
        "Match": {
          "Path": "/api/accounts/{**remainder}"
        }
      },
      "identity-api": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/identity/{**remainder}"
        }
      },
      "identity-connect": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/connect/{**remainder}"
        }
      },
      "identity-well-known": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/.well-known/{**remainder}"
        }
      },
      "identity-account": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/Account/{**remainder}"
        }
      },
      "identity-consent": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/Consent/{**remainder}"
        }
      },
      "identity-device": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/Device/{**remainder}"
        }
      },
      "identity-external-login": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/ExternalLogin/{**remainder}"
        }
      },
      "identity-grants": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/Grants/{**remainder}"
        }
      },
      "identity-redirect": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/Redirect/{**remainder}"
        }
      },
      "identity-diagnostics": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/Diagnostics/{**remainder}"
        }
      },
      "identity-error": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/Home/{**remainder}"
        }
      },
      "identity-ciba": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/Ciba/{**remainder}"
        }
      },
      "identity-sessions": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/ServerSideSessions/{**remainder}"
        }
      },
      "identity-static-lib": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/lib/{**remainder}"
        }
      },
      "identity-static-css": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/css/{**remainder}"
        }
      },
      "identity-static-js": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/js/{**remainder}"
        }
      },
      "identity-favicon": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/favicon.ico"
        }
      },
      "identity-logo": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/duende-logo.svg"
        }
      }
    },
    "Clusters": {
      "accounts": {
        "Destinations": {
          "accountsDestination": {
            "Address": "https://accounts"
          }
        }
      },
      "identity": {
        "Destinations": {
          "identityDestination": {
            "Address": "https://identity"
          }
        }
      }
    }
  }
}
