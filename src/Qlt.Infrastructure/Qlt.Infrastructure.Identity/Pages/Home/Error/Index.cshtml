@page
@model Qlt.Infrastructure.Identity.Pages.Home.Error.Index

<div class="identity-page identity-page-result error-page">
    <section class="identity-card identity-card-narrow identity-result-card">
        <div class="identity-page-header">
            <h1 class="identity-title">Error</h1>
        </div>

            <div class="alert alert-danger identity-alert" role="alert">
                Sorry, there was an error

                @if (Model.View.Error is not null)
                {
                    <strong>
                        <em>
                            : @Model.View.Error.Error
                        </em>
                    </strong>

                    if (Model.View.Error.ErrorDescription is not null)
                    {
                        <div>@Model.View.Error.ErrorDescription</div>
                    }
                }
            </div>

            @if (Model?.View?.Error?.RequestId is not null)
            {
                <div class="request-id identity-request-id">Request Id: @Model.View.Error.RequestId</div>
            }
    </section>
</div>
