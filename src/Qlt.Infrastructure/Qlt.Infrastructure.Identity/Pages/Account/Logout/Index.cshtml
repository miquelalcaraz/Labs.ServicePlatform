@page
@namespace Qlt.Infrastructure.Identity.Pages.Account.Logout
@model Qlt.Infrastructure.Identity.Pages.Account.Logout.Index

<div class="identity-page identity-page-form logout-page">
    <section class="identity-card identity-card-narrow">
        <div class="identity-page-header">
            <h1 class="identity-title">Sign out</h1>
            <p class="identity-support-text">Would you like to sign out of Qlt Identity?</p>
        </div>

        <form asp-page="/Account/Logout/Index">
            <input type="hidden" name="logoutId" value="@Model.LogoutId"  />

            <div class="identity-actions">
                <button class="btn btn-primary identity-primary-action">Sign out</button>
            </div>
        </form>
    </section>
</div>