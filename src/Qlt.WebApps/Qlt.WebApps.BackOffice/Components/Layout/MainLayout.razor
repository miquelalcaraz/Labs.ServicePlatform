@inherits LayoutComponentBase
<RadzenComponents @rendermode="InteractiveServer" />
 
<RadzenDialog />
<RadzenNotification />
<RadzenTooltip />
<RadzenContextMenu />

<RadzenLayout>
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0">
            <RadzenSidebarToggle Click="@(() => sidebarExpanded = !sidebarExpanded)" />
            <HeaderBar />
        </RadzenStack>
    </RadzenHeader>



    <RadzenSidebar @ref="@sidebar" Responsive="false" Style="width: max-content">
        <RadzenPanelMenu DisplayStyle="@(sidebarExpanded? MenuItemDisplayStyle.IconAndText: MenuItemDisplayStyle.Icon)" ShowArrow="false">
            <RadzenPanelMenuItem Text="Home" Icon="home" Path="/" />
            <RadzenPanelMenuItem Text="Customer Onboarding" Icon="group_add">
                <RadzenPanelMenuItem Text="Onboarding List" Icon="list" Path="/onboarding" />
                <RadzenPanelMenuItem Text="Start Onboarding" Icon="add_circle" Path="/onboarding/start" />
            </RadzenPanelMenuItem>
        </RadzenPanelMenu>
    </RadzenSidebar>

    <RadzenBody @ref="@body">
        <RadzenRow Gap="0" class="rz-mx-auto" Style="max-width: 1600px; padding: 1rem 2rem;">
            @Body
        </RadzenRow>
    </RadzenBody>
</RadzenLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>


 
@code {
    RadzenSidebar? sidebar;
    RadzenBody? body;
    bool sidebarExpanded = true;
}
