@page "/onboarding/start"
@attribute [Authorize]
@inject OnboardingApiService Api
@inject NavigationManager Nav
@inject NotificationService Notification

<PageTitle>Start Customer Onboarding</PageTitle>

<RadzenStack Orientation="Orientation.Vertical" Gap="1rem" Style="max-width: 800px;">
    <RadzenRow JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
        <RadzenColumn>
            <RadzenText TextStyle="TextStyle.H4" Text="Start Customer Onboarding" />
        </RadzenColumn>
        <RadzenColumn>
            <RadzenButton Text="Back to List" Icon="arrow_back" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text"
                          Click="@(() => Nav.NavigateTo("/onboarding"))" />
        </RadzenColumn>
    </RadzenRow>

    @if (errorMessage is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="true"
                     Close="@(() => errorMessage = null)">
            @errorMessage
        </RadzenAlert>
    }

    <RadzenTemplateForm TItem="StartOnboardingRequest" Data="@model" Submit="@OnSubmitAsync">
        <RadzenFieldset Text="Company Information">
            <RadzenStack Gap="1rem">
                <RadzenRow>
                    <RadzenColumn Size="8">
                        <RadzenFormField Text="Legal Name" Variant="Variant.Outlined" Style="width: 100%;">
                            <ChildContent>
                                <RadzenTextBox Name="LegalName" @bind-Value="@model.Company.LegalName" />
                            </ChildContent>
                            <Helper>
                                <RadzenRequiredValidator Component="LegalName" Text="Legal name is required." />
                            </Helper>
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="4">
                        <RadzenFormField Text="Country Code" Variant="Variant.Outlined" Style="width: 100%;">
                            <ChildContent>
                                <RadzenTextBox Name="CountryCode" @bind-Value="@model.Company.CountryCode" />
                            </ChildContent>
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow>
                    <RadzenColumn Size="8">
                        <RadzenFormField Text="Trade Name" Variant="Variant.Outlined" Style="width: 100%;">
                            <ChildContent>
                                <RadzenTextBox Name="TradeName" @bind-Value="@model.Company.TradeName" />
                            </ChildContent>
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="4">
                        <RadzenFormField Text="Tax ID" Variant="Variant.Outlined" Style="width: 100%;">
                            <ChildContent>
                                <RadzenTextBox Name="TaxId" @bind-Value="@model.Company.TaxId" />
                            </ChildContent>
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenStack>
        </RadzenFieldset>

        <RadzenFieldset Text="Subscription">
            <RadzenFormField Text="Plan Code" Variant="Variant.Outlined" Style="width: 100%;">
                <ChildContent>
                    <RadzenTextBox Name="SubscriptionPlanCode" @bind-Value="@model.Subscription.SubscriptionPlanCode" />
                </ChildContent>
                <Helper>
                    <RadzenRequiredValidator Component="SubscriptionPlanCode" Text="Subscription plan code is required." />
                </Helper>
            </RadzenFormField>
        </RadzenFieldset>

        <RadzenFieldset Text="Admin User">
            <RadzenStack Gap="1rem">
                <RadzenRow>
                    <RadzenColumn Size="6">
                        <RadzenFormField Text="First Name" Variant="Variant.Outlined" Style="width: 100%;">
                            <ChildContent>
                                <RadzenTextBox Name="FirstName" @bind-Value="@model.AdminUser.FirstName" />
                            </ChildContent>
                            <Helper>
                                <RadzenRequiredValidator Component="FirstName" Text="First name is required." />
                            </Helper>
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="6">
                        <RadzenFormField Text="Last Name" Variant="Variant.Outlined" Style="width: 100%;">
                            <ChildContent>
                                <RadzenTextBox Name="LastName" @bind-Value="@model.AdminUser.LastName" />
                            </ChildContent>
                            <Helper>
                                <RadzenRequiredValidator Component="LastName" Text="Last name is required." />
                            </Helper>
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow>
                    <RadzenColumn Size="8">
                        <RadzenFormField Text="Email" Variant="Variant.Outlined" Style="width: 100%;">
                            <ChildContent>
                                <RadzenTextBox Name="Email" @bind-Value="@model.AdminUser.Email" />
                            </ChildContent>
                            <Helper>
                                <RadzenRequiredValidator Component="Email" Text="Email is required." />
                                <RadzenEmailValidator Component="Email" Text="Invalid email format." />
                            </Helper>
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="4">
                        <RadzenFormField Text="Language" Variant="Variant.Outlined" Style="width: 100%;">
                            <ChildContent>
                                <RadzenDropDown TValue="string" Name="PreferredLanguage"
                                                @bind-Value="@model.AdminUser.PreferredLanguage"
                                                Data="@languages" AllowClear="true"
                                                Placeholder="Select..." />
                            </ChildContent>
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenStack>
        </RadzenFieldset>

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
            <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat"
                          Click="@(() => Nav.NavigateTo("/onboarding"))" ButtonType="ButtonType.Button" />
            <RadzenButton Text="Start Onboarding" Icon="play_arrow" ButtonStyle="ButtonStyle.Primary"
                          ButtonType="ButtonType.Submit" IsBusy="@isSubmitting" BusyText="Starting..." />
        </RadzenStack>
    </RadzenTemplateForm>
</RadzenStack>

@code {
    private StartOnboardingRequest model = new();
    private bool isSubmitting;
    private string? errorMessage;

    private readonly List<string> languages = ["en", "es", "fr", "de", "pt", "it"];

    private async Task OnSubmitAsync()
    {
        isSubmitting = true;
        errorMessage = null;

        try
        {
            var result = await Api.StartOnboardingAsync(model);

            if (result.IsSuccess)
            {
                Notification.Notify(NotificationSeverity.Success, "Onboarding Started",
                    $"Process {result.Value!.OnboardingProcessId} has been initiated.");
                Nav.NavigateTo($"/onboarding/{result.Value.OnboardingProcessId}");
            }
            else
            {
                errorMessage = result.ErrorMessage ?? "Failed to start onboarding. Please check your input and try again.";
            }
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
