@page "/onboarding"
@attribute [Authorize]

@using Qlt.BackOfficeApp.Services
@using Qlt.BackOfficeApp.Models

@inject OnboardingApiService Api
@inject NavigationManager Nav

<PageTitle>Customer Onboarding</PageTitle>

<RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
    <RadzenRow JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
        <RadzenColumn>
            <RadzenText TextStyle="TextStyle.H4" Text="Customer Onboarding" />
        </RadzenColumn>
        <RadzenColumn>
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                <RadzenButton Text="Start Onboarding" Icon="add_circle" ButtonStyle="ButtonStyle.Primary"
                              Click="@(() => Nav.NavigateTo("/onboarding/start"))" />
                <RadzenButton Text="Refresh" Icon="refresh" ButtonStyle="ButtonStyle.Light"
                              Click="@LoadDataAsync" />
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>

    <RadzenCard>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.End" Wrap="FlexWrap.Wrap">
            <RadzenStack Gap="0.25rem">
                <RadzenLabel Text="Status" />
                <RadzenDropDown @bind-Value="@statusFilter" Data="@statusOptions"
                                Placeholder="All statuses" AllowClear="true" Style="width: 200px;"
                                Change="@(args => LoadDataAsync())" />
            </RadzenStack>
            <RadzenStack Gap="0.25rem">
                <RadzenLabel Text="Company" />
                <RadzenTextBox @bind-Value="@companyFilter" Placeholder="Search by company..."
                               Style="width: 200px;" />
            </RadzenStack>
            <RadzenStack Gap="0.25rem">
                <RadzenLabel Text="Admin Email" />
                <RadzenTextBox @bind-Value="@emailFilter" Placeholder="Search by email..."
                               Style="width: 200px;" />
            </RadzenStack>
            <RadzenButton Text="Search" Icon="search" ButtonStyle="ButtonStyle.Secondary"
                          Click="@LoadDataAsync" />
        </RadzenStack>
    </RadzenCard>

    @if (isLoading)
    {
        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    }
    else if (errorMessage is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter">
            @errorMessage
        </RadzenAlert>
    }
    else
    {
        <RadzenDataGrid Data="@items" TItem="OnboardingProcessListItemResponse" AllowPaging="true"
                        PageSize="@pageSize" Count="@totalCount" AllowSorting="false"
                        PagerHorizontalAlign="HorizontalAlign.Center" ShowPagingSummary="true"
                        PagingSummaryFormat="Showing page {0} of {1} ({2} records)"
                        Page="@OnPageChanged">
            <Columns>
                <RadzenDataGridColumn TItem="OnboardingProcessListItemResponse" Property="CompanyLegalName"
                                      Title="Company" Width="200px" />
                <RadzenDataGridColumn TItem="OnboardingProcessListItemResponse" Property="SubscriptionPlanCode"
                                      Title="Plan" Width="120px" />
                <RadzenDataGridColumn TItem="OnboardingProcessListItemResponse" Property="AdminEmail"
                                      Title="Admin Email" Width="200px" />
                <RadzenDataGridColumn TItem="OnboardingProcessListItemResponse" Property="StatusDisplayName"
                                      Title="Status" Width="180px">
                    <Template Context="item">
                        <RadzenBadge BadgeStyle="@GetStatusBadgeStyle(item.Status)" Text="@item.StatusDisplayName" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="OnboardingProcessListItemResponse" Property="CurrentStepDisplayName"
                                      Title="Current Step" Width="200px" />
                <RadzenDataGridColumn TItem="OnboardingProcessListItemResponse" Property="StartedAtUtc"
                                      Title="Started" Width="160px" FormatString="{0:yyyy-MM-dd HH:mm}" />
                <RadzenDataGridColumn TItem="OnboardingProcessListItemResponse" Property="RetryCount"
                                      Title="Retries" Width="80px" TextAlign="TextAlign.Center" />
                <RadzenDataGridColumn TItem="OnboardingProcessListItemResponse" Title="Actions" Width="160px"
                                      TextAlign="TextAlign.Center" Sortable="false">
                    <Template Context="item">
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem" JustifyContent="JustifyContent.Center">
                            @if (item.Actions.CanOpen)
                            {
                                <RadzenButton Icon="visibility" ButtonStyle="ButtonStyle.Info" Variant="Variant.Text"
                                              Size="ButtonSize.Small"
                                              Click="@(() => Nav.NavigateTo($"/onboarding/{item.OnboardingProcessId}"))" />
                            }
                            @if (item.Actions.CanRetry)
                            {
                                <RadzenButton Icon="replay" ButtonStyle="ButtonStyle.Warning" Variant="Variant.Text"
                                              Size="ButtonSize.Small"
                                              Click="@(() => RetryAsync(item.OnboardingProcessId))" />
                            }
                        </RadzenStack>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }
</RadzenStack>

 
