@inject NavigationManager NavigationManager

@code {
    [Parameter]
    public bool IsAuthenticated { get; set; }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;

        var currentPath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);

        if (!IsAuthenticated)
        {
            if (currentPath.StartsWith("auth/", StringComparison.OrdinalIgnoreCase)) return;
            var returnUrl = string.IsNullOrEmpty(currentPath) ? "/" : $"/{currentPath}";
            NavigationManager.NavigateTo($"auth/Login?returnUrl={Uri.EscapeDataString(returnUrl)}", true);
        }
        else
        {
            if (currentPath.Equals("unauthorized", StringComparison.OrdinalIgnoreCase)) return;
            NavigationManager.NavigateTo("Unauthorized");
        }
    }
}
