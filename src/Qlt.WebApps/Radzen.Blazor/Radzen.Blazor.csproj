<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFrameworks>net10.0</TargetFrameworks>
		<RazorLangVersion>7.0</RazorLangVersion>
		<LangVersion>latest</LangVersion>
		<Version>10.2.0-custom</Version>
		<NoWarn>BL9993;BL0007;BL0005</NoWarn>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<EnableNETAnalyzers>false</EnableNETAnalyzers>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components" Version="10.*-*" />
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.*-*" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="LinkerConfig.xml">
			<LogicalName>$(MSBuildProjectName).xml</LogicalName>
		</EmbeddedResource>
		<None Include="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
		<Content Remove="wwwroot/Radzen.Blazor.min.js" />
		<Content Remove="wwwroot/css/**/*.css" />
	</ItemGroup>

	<Target Name="IncludeCss" BeforeTargets="BeforeBuild">
		<ItemGroup>
			<Content Include="wwwroot/css/**/*.css" />
		</ItemGroup>
	</Target>

</Project>
