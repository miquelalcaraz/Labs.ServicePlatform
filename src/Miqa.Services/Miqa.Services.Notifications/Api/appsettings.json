{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OpenApi": {
    "Endpoint": {
      "Name": "Notifications.API V1"
    },
    "Document": {
      "Description": "The Notifications Service HTTP API",
      "Title": "Miqa - Notifications HTTP API",
      "Version": "v1"
    },
    "Auth": {
      "ClientId": "Notificationswaggerui",
      "AppName": "Account Swagger UI"
    }
  },
  "ConnectionStrings": {
    "eventbus": "Endpoint=sb://{namespace}.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey={key}"
  },
  "EventBus": {
    "SubscriptionClientName": "Notifications"
  },
  "IdempotencyCache": {
    "ProcessingTtl": "00:00:30",
    "CompletedTtl": "00:05:00",
    "KeyPrefix": "idempotency:"
  },
  "Identity": {
    "Audience": "notifications",
    "Scopes": {
      "Notifications": "Notifications API"
    }
  },
  "AllowedHosts": "*"
}
