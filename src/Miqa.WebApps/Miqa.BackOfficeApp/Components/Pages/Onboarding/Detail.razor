@page "/onboarding/{OnboardingProcessId:guid}"
@attribute [Authorize]
@implements IAsyncDisposable

@using Miqa.BackOfficeApp.Services
@using Miqa.BackOfficeApp.Models


@inject OnboardingApiService Api
@inject NavigationManager Nav
@inject NotificationService Notification

<PageTitle>Onboarding Detail</PageTitle>

@if (isLoading)
{
    <RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Style="min-height: 300px;">
        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
        <RadzenText TextStyle="TextStyle.Body1" Text="Loading onboarding process..." />
    </RadzenStack>
}
else if (detail is null)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter">
        @(errorMessage ?? "Onboarding process not found.")
    </RadzenAlert>
    <RadzenButton Text="Back to List" Icon="arrow_back" ButtonStyle="ButtonStyle.Light"
                  Click="@(() => Nav.NavigateTo("/onboarding"))" Style="margin-top: 1rem;" />
}
else
{
    <RadzenStack Orientation="Orientation.Vertical" Gap="1.5rem">

        @* Header *@
        <RadzenRow JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Start">
            <RadzenColumn>
                <RadzenStack Gap="0.25rem">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                        <RadzenText TextStyle="TextStyle.H4" Text="Onboarding Detail" />
                        <RadzenBadge BadgeStyle="@GetStatusBadgeStyle(detail.Status)" Text="@detail.StatusDisplayName"
                                     Style="font-size: 0.9rem;" />
                    </RadzenStack>
                    <RadzenText TextStyle="TextStyle.Caption"
                                Text="@($"ID: {detail.OnboardingProcessId}")"
                                Style="color: var(--rz-text-tertiary-color);" />
                </RadzenStack>
            </RadzenColumn>
            <RadzenColumn>
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                    <RadzenButton Text="Back to List" Icon="arrow_back" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text"
                                  Click="@(() => Nav.NavigateTo("/onboarding"))" />
                    @if (detail.Actions.CanRefresh)
                    {
                        <RadzenButton Text="Refresh" Icon="refresh" ButtonStyle="ButtonStyle.Light"
                                      Click="@RefreshAsync" />
                    }
                    @if (detail.Actions.CanRetry)
                    {
                        <RadzenButton Text="Retry" Icon="replay" ButtonStyle="ButtonStyle.Warning"
                                      Click="@RetryAsync" IsBusy="@isRetrying" BusyText="Retrying..." />
                    }
                    @if (detail.Actions.CanOpenCustomer)
                    {
                        <RadzenButton Text="View Customer" Icon="person" ButtonStyle="ButtonStyle.Success"
                                      Click="@(() => Nav.NavigateTo($"/onboarding/{OnboardingProcessId}/result"))" />
                    }
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>

        @* Summary Cards *@
        <RadzenRow Gap="1rem">
            <RadzenColumn Size="4">
                <RadzenCard Style="height: 100%;">
                    <RadzenStack Gap="0.5rem">
                        <RadzenText TextStyle="TextStyle.Overline" Text="COMPANY" />
                        <RadzenText TextStyle="TextStyle.H6" Text="@(detail.Summary.CompanyLegalName ?? "—")" />
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>
            <RadzenColumn Size="4">
                <RadzenCard Style="height: 100%;">
                    <RadzenStack Gap="0.5rem">
                        <RadzenText TextStyle="TextStyle.Overline" Text="SUBSCRIPTION PLAN" />
                        <RadzenText TextStyle="TextStyle.H6" Text="@(detail.Summary.SubscriptionPlanCode ?? "—")" />
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>
            <RadzenColumn Size="4">
                <RadzenCard Style="height: 100%;">
                    <RadzenStack Gap="0.5rem">
                        <RadzenText TextStyle="TextStyle.Overline" Text="ADMIN EMAIL" />
                        <RadzenText TextStyle="TextStyle.H6" Text="@(detail.Summary.AdminEmail ?? "—")" />
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>
        </RadzenRow>

        @* Progress *@
        <RadzenCard>
            <RadzenStack Gap="1rem">
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween"
                             AlignItems="AlignItems.Center">
                    <RadzenText TextStyle="TextStyle.H6" Text="Progress" />
                    <RadzenText TextStyle="TextStyle.Body2"
                                Text="@($"{detail.ProgressPercent}% — {detail.CurrentStepDisplayName}")" />
                </RadzenStack>
                <RadzenProgressBar Value="@detail.ProgressPercent" ShowValue="false"
                                   Style="height: 8px;"
                                   ProgressBarStyle="@GetProgressBarStyle(detail.Status)" />
            </RadzenStack>
        </RadzenCard>

        @* Steps Tracker *@
        <RadzenCard>
            <RadzenText TextStyle="TextStyle.H6" Text="Steps" Style="margin-bottom: 1rem;" />
            <RadzenStack Gap="0.25rem">
                @foreach (var step in detail.Steps)
                {
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem"
                                 Style="padding: 0.5rem 0.75rem; border-radius: 4px; background: var(--rz-base-200);">
                        @if (step.Status == "Completed")
                        {
                            <RadzenIcon Icon="check_circle" Style="color: var(--rz-success); font-size: 1.25rem;" />
                        }
                        else if (step.Status == "Current")
                        {
                            <RadzenIcon Icon="hourglass_empty" Style="color: var(--rz-info); font-size: 1.25rem;" />
                        }
                        else if (step.Status == "Failed")
                        {
                            <RadzenIcon Icon="error" Style="color: var(--rz-danger); font-size: 1.25rem;" />
                        }
                        else
                        {
                            <RadzenIcon Icon="radio_button_unchecked" Style="color: var(--rz-text-disabled-color); font-size: 1.25rem;" />
                        }
                        <RadzenText TextStyle="TextStyle.Body2" Text="@step.DisplayName" Style="flex: 1;" />
                        <RadzenBadge Text="@step.Status" BadgeStyle="@GetStepBadgeStyle(step.Status)" />
                    </RadzenStack>
                }
            </RadzenStack>
        </RadzenCard>

        @* Error Section *@
        @if (detail.LastError is not null)
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter">
                <RadzenStack Gap="0.5rem">
                    <RadzenText TextStyle="TextStyle.Subtitle1">
                        <strong>Error:</strong> @(detail.LastError.Code ?? "Unknown")
                    </RadzenText>
                    <RadzenText TextStyle="TextStyle.Body2" Text="@detail.LastError.Message" />
                    @if (detail.LastError.FailedStep is not null)
                    {
                        <RadzenText TextStyle="TextStyle.Caption"
                                    Text="@($"Failed at step: {detail.LastError.FailedStep}")" />
                    }
                    @if (detail.LastError.OccurredAtUtc.HasValue)
                    {
                        <RadzenText TextStyle="TextStyle.Caption"
                                    Text="@($"Occurred at: {detail.LastError.OccurredAtUtc:yyyy-MM-dd HH:mm:ss} UTC")" />
                    }
                </RadzenStack>
            </RadzenAlert>
        }

        @* Technical Details (collapsible) *@
        <RadzenCard>
            <RadzenPanelMenu>
                <RadzenPanelMenuItem Text="Technical Details" Icon="settings">
                    <RadzenStack Gap="0.5rem" Style="padding: 0.5rem 0;">
                        <RadzenRow>
                            <RadzenColumn Size="3"><RadzenText TextStyle="TextStyle.Body2"><strong>Correlation ID</strong></RadzenText></RadzenColumn>
                            <RadzenColumn Size="9"><RadzenText TextStyle="TextStyle.Body2" Text="@(detail.CorrelationId?.ToString() ?? "—")" /></RadzenColumn>
                        </RadzenRow>
                        <RadzenRow>
                            <RadzenColumn Size="3"><RadzenText TextStyle="TextStyle.Body2"><strong>Started At</strong></RadzenText></RadzenColumn>
                            <RadzenColumn Size="9"><RadzenText TextStyle="TextStyle.Body2" Text="@($"{detail.StartedAtUtc:yyyy-MM-dd HH:mm:ss} UTC")" /></RadzenColumn>
                        </RadzenRow>
                        @if (detail.CompletedAtUtc.HasValue)
                        {
                            <RadzenRow>
                                <RadzenColumn Size="3"><RadzenText TextStyle="TextStyle.Body2"><strong>Completed At</strong></RadzenText></RadzenColumn>
                                <RadzenColumn Size="9"><RadzenText TextStyle="TextStyle.Body2" Text="@($"{detail.CompletedAtUtc.Value:yyyy-MM-dd HH:mm:ss} UTC")" /></RadzenColumn>
                            </RadzenRow>
                        }
                        @if (detail.FailedAtUtc.HasValue)
                        {
                            <RadzenRow>
                                <RadzenColumn Size="3"><RadzenText TextStyle="TextStyle.Body2"><strong>Failed At</strong></RadzenText></RadzenColumn>
                                <RadzenColumn Size="9"><RadzenText TextStyle="TextStyle.Body2" Text="@($"{detail.FailedAtUtc.Value:yyyy-MM-dd HH:mm:ss} UTC")" /></RadzenColumn>
                            </RadzenRow>
                        }
                        <RadzenRow>
                            <RadzenColumn Size="3"><RadzenText TextStyle="TextStyle.Body2"><strong>Retry Count</strong></RadzenText></RadzenColumn>
                            <RadzenColumn Size="9"><RadzenText TextStyle="TextStyle.Body2" Text="@detail.RetryCount.ToString()" /></RadzenColumn>
                        </RadzenRow>
                        <RadzenRow>
                            <RadzenColumn Size="3"><RadzenText TextStyle="TextStyle.Body2"><strong>Subscription ID</strong></RadzenText></RadzenColumn>
                            <RadzenColumn Size="9"><RadzenText TextStyle="TextStyle.Body2" Text="@detail.References.SubscriptionId.ToString()" /></RadzenColumn>
                        </RadzenRow>
                        <RadzenRow>
                            <RadzenColumn Size="3"><RadzenText TextStyle="TextStyle.Body2"><strong>Tenant ID</strong></RadzenText></RadzenColumn>
                            <RadzenColumn Size="9"><RadzenText TextStyle="TextStyle.Body2" Text="@detail.References.TenantId.ToString()" /></RadzenColumn>
                        </RadzenRow>
                        @if (detail.References.OwnerCompanyId.HasValue)
                        {
                            <RadzenRow>
                                <RadzenColumn Size="3"><RadzenText TextStyle="TextStyle.Body2"><strong>Company ID</strong></RadzenText></RadzenColumn>
                                <RadzenColumn Size="9"><RadzenText TextStyle="TextStyle.Body2" Text="@detail.References.OwnerCompanyId.ToString()" /></RadzenColumn>
                            </RadzenRow>
                        }
                        @if (detail.References.AdminUserId.HasValue)
                        {
                            <RadzenRow>
                                <RadzenColumn Size="3"><RadzenText TextStyle="TextStyle.Body2"><strong>Admin User ID</strong></RadzenText></RadzenColumn>
                                <RadzenColumn Size="9"><RadzenText TextStyle="TextStyle.Body2" Text="@detail.References.AdminUserId.ToString()" /></RadzenColumn>
                            </RadzenRow>
                        }
                    </RadzenStack>
                </RadzenPanelMenuItem>
            </RadzenPanelMenu>
        </RadzenCard>

        @* Polling indicator *@
        @if (isPolling)
        {
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem"
                         JustifyContent="JustifyContent.Center">
                <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
                <RadzenText TextStyle="TextStyle.Caption"
                            Text="@($"Auto-refreshing every {pollingIntervalSeconds}s...")"
                            Style="color: var(--rz-text-tertiary-color);" />
            </RadzenStack>
        }
    </RadzenStack>
}

 