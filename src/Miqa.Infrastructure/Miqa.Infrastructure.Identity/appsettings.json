{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OpenApi": {
    "Endpoint": {
      "Name": "Identity.API V1"
    },
    "Document": {
      "Description": "The Identity Service HTTP API",
      "Title": "Miqa - Identity HTTP API",
      "Version": "v1"
    }
  },
  "ConnectionStrings": {
    "eventbus": "Endpoint=sb://{namespace}.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey={key}"
  },
  "EventBus": {
    "SubscriptionClientName": "Identity"
  },
  "ExternalProviders": [
    {
      "Scheme": "EntraId",
      "DisplayName": "Microsoft Entra ID",
      "Authority": "https://login.microsoftonline.com/<tenant-id>/v2.0",
      "ClientId": "",
      "ClientSecret": "",
      "Enabled": false
    }
  ],
  "AllowedHosts": "*"
}
