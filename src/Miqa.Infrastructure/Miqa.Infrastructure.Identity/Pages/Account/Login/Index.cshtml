@page
@namespace Miqa.Infrastructure.Identity.Pages.Account.Login
@model Miqa.Infrastructure.Identity.Pages.Account.Login.Index

<div class="identity-page identity-page-form login-page">
    <section class="identity-card identity-card-wide">
        <div class="identity-page-header">
            <h1 class="identity-title">Sign in</h1>
            <p class="identity-support-text">Use your Miqa account to continue.</p>
        </div>

        <partial name="_ValidationSummary" />

        <div class="row identity-login-options">

            @if (Model.View.EnableLocalLogin)
            {
                <div class="@(Model.View.VisibleExternalProviders.Any() ? "col-lg-6" : "col-12")">
                    <div class="card identity-section-card h-100">
                        <div class="card-body">
                            <h2 class="identity-section-title">Local account</h2>

                            <form asp-page="/Account/Login/Index" class="identity-form-stack">
                                <input type="hidden" asp-for="Input.ReturnUrl" />

                                <div class="form-group">
                                    <label asp-for="Input.Username"></label>
                                    <input class="form-control" placeholder="Username" asp-for="Input.Username" autofocus>
                                </div>
                                <div class="form-group">
                                    <label asp-for="Input.Password"></label>
                                    <input type="password" class="form-control" placeholder="Password" asp-for="Input.Password" autocomplete="off">
                                </div>

                                @if (Model.View.AllowRememberLogin)
                                {
                                    <div class="form-group">
                                        <div class="form-check identity-checkbox-row">
                                            <input class="form-check-input" asp-for="Input.RememberLogin">
                                            <label class="form-check-label" asp-for="Input.RememberLogin">
                                                Remember my sign-in
                                            </label>
                                        </div>
                                    </div>
                                }

                                <div class="identity-actions">
                                    <button class="btn btn-primary identity-primary-action" name="Input.Button" value="login">Sign in</button>
                                    <button class="btn btn-secondary identity-secondary-action" name="Input.Button" value="cancel">Cancel</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }

            @if (Model.View.VisibleExternalProviders.Any())
            {
                <div class="@(Model.View.EnableLocalLogin ? "col-lg-6" : "col-12")">
                    <div class="card identity-section-card h-100">
                        <div class="card-body">
                            <h2 class="identity-section-title">External account</h2>
                            <p class="identity-support-text identity-support-text-sm">Choose an available sign-in method.</p>
                            <div class="identity-external-actions">
                                @foreach (var provider in Model.View.VisibleExternalProviders)
                                {
                                    <a class="btn btn-secondary identity-external-button"
                                       asp-page="/ExternalLogin/Challenge"
                                       asp-route-scheme="@provider.AuthenticationScheme"
                                       asp-route-returnUrl="@Model.Input.ReturnUrl">
                                        @provider.DisplayName
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }

            @if (!Model.View.EnableLocalLogin && !Model.View.VisibleExternalProviders.Any())
            {
                <div class="col-12">
                    <div class="alert alert-warning identity-alert" role="alert">
                        <strong>Invalid sign-in request.</strong>
                        There are no login schemes configured for this request.
                    </div>
                </div>
            }
        </div>
    </section>
</div>