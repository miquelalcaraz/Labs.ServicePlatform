<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>Sirius.Platform</RootNamespace>
		<IsAspireSharedProject>true</IsAspireSharedProject>
		<IsPackable>true</IsPackable>
		<PackageId>Sirius.Platform.ServiceDefaults</PackageId>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.2.1" />
		<PackageReference Include="Scalar.AspNetCore" Version="2.18.0" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />

		<PackageReference Include="Asp.Versioning.Http" Version="10.2.3" />

		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
		<PackageReference Include="Microsoft.OpenApi" Version="2.12.2" />
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />


		<PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
		<PackageReference Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.0" />
		<PackageReference Include="StackExchange.Redis" Version="3.4.5" />
		<PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.0" />
		<PackageReference Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" Version="1.15.0-beta.1" />
		<PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.20.0" />
		<PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.0" />
		<PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.20.0" />
		<PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Sirius.Platform.Telemetry\Platform.Telemetry.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Nerdbank.GitVersioning" Version="3.10.94">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>



</Project>
