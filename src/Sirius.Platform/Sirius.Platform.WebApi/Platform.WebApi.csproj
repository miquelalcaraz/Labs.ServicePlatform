<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>Sirius.Platform</RootNamespace>
		<Nullable>enable</Nullable>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<IsPackable>true</IsPackable>
		<PackageId>Sirius.Platform.WebApi</PackageId>
	</PropertyGroup>
	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

 
	<ItemGroup>
		<ProjectReference Include="..\Sirius.Platform.Infrastructure\Platform.Infrastructure.csproj" />
		<ProjectReference Include="..\..\Sirius.Platform\Sirius.Platform.ServiceDefaults\Platform.ServiceDefaults.csproj" />
	</ItemGroup>


	<ItemGroup>
		<PackageReference Include="Nerdbank.GitVersioning" Version="3.10.94">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>


</Project>
